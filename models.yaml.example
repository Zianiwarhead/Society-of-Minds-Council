- id: "glm-4.6-coder"
  provider: "openrouter"
  endpoint: "https://openrouter.ai/api/v1/chat/completions"
  api_key_env: "OPENROUTER_API_KEY"
  cost_tier: "free"
  capabilities: ["code_generation", "boilerplate", "refactor_simple"]
  not_trusted_for: ["security_audit", "cross_file_architecture"]
  context_window: 128000
  quality_score:
    value: 0.72
    source: "user_override"
    last_updated: "2026-09-12"
  latency_class: "fast"
  escalates_to: "claude-sonnet-openrouter"

- id: "claude-sonnet-openrouter"
